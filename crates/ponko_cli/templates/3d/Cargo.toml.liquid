[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"

# What `ponko package` puts in the download players get
# (https://ponko.dev/guide/packaging.html).
[package.metadata.ponko]
name = "{{project-name}}"            # the name players see
# id = "com.example.my-game"         # a reverse-DNS id you own (the macOS bundle id)
# icon = "assets/icon.png"           # a square PNG, 512 or 1024 pixels
assets = ["assets"]                  # shipped next to the program

[dependencies]
# The engine with its default features (a window, sound, gamepads and the
# inspector) plus 3D: meshes, materials, glTF models, a perspective camera
# and a sun. Add "physics3d" for 3D physics. https://ponko.dev/guide/3d.html
ponko = { version = "0.1", features = ["3d"] }
serde = { version = "1", features = ["derive"] }

# Fast debug builds: your code with light optimization, the engine and the
# other dependencies fully optimized. Games and tests run many times faster
# than a plain debug build; edit -> build stays quick, debug info stays.
[profile.dev]
opt-level = 1

[profile.dev.package."*"]
opt-level = 3
